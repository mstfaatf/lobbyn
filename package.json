{
  "name": "lobbyn",
  "pnpm": {
    "onlyBuiltDependencies": ["argon2"]
  },
  "private": true,
  "scripts": {
    "dev:api": "pnpm --filter @lobbyn/api dev",
    "build:api": "pnpm --filter @lobbyn/api build",
    "lint": "eslint \"apps/api/src/**/*.ts\" \"packages/shared/src/**/*.ts\"",
    "typecheck": "tsc --noEmit -p apps/api/tsconfig.json && tsc --noEmit -p packages/shared/tsconfig.json",
    "format": "prettier --write \"apps/api/src/**/*.ts\" \"packages/shared/src/**/*.ts\""
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.8.3",
    "typescript": "^6.0.3"
  }
}
